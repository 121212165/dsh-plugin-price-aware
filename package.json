{
  "name": "dsh-plugin-price-aware",
  "version": "0.1.0",
  "description": "Make your coding agent know what it costs: live credits, per-model price, task pre-estimates, and a budget gate.",
  "type": "module",
  "license": "MIT",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./pricing": {
      "types": "./lib/types/pricing/index.d.ts",
      "default": "./lib/pricing/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "node --test \"test/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "cordis",
    "plugin",
    "cost",
    "budget",
    "tokens",
    "pricing"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/121212165/dsh-plugin-price-aware.git"
  },
  "bugs": {
    "url": "https://github.com/121212165/dsh-plugin-price-aware/issues"
  },
  "sideEffects": false,
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-base": "^0.1.2-alpha.4",
    "@deepseek-ai/schemastery": "^3.18.2",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.0"
  }
}
